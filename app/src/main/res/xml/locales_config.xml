<?xml version="1.0" encoding="utf-8"?>
<!-- The languages MailCtrl is translated into. Android picks one from the phone's language (and lists them
     under the app's own language setting in Android's settings); there is no language picker in the app. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="nl" />
    <locale android:name="fr" />
    <locale android:name="de" />
</locale-config>
